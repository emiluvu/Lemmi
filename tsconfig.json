{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["ES2022"]
  },
  "include": [
    "packages/**/*.ts",
    "apps/realtime/**/*.ts",
    "apps/worker/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
