{
  "name": "@lemmi/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "bun --bun vite build",
    "check": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@lemmi/contracts": "workspace:*",
    "@lemmi/server": "workspace:*",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/adapter-bun": "1.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@opentelemetry/api": "1.9.0",
    "vite": "8.3.8",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
