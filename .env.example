# MOCK-ONLY foundation. Copy to .env locally; never place real credentials here.
LEMMI_MODE=mock
GATEWAY_PORT=3001
# Local development transport credential, NOT production device pairing or caregiver auth.
LEMMI_MOCK_TOKEN=local-mock-only

# Optional authenticated CONTROL foundation. Leave blank for the default mock starter.
# Set LEMMI_MODE=live explicitly for gateway/web/control harness; full product services remain unavailable.
# Only a selected trusted local HTTPS/WSS proxy may expose the resource routes in the handoff.
LEMMI_PUBLIC_ORIGIN=
# Independent random secret (>=32 characters), shared only by SvelteKit and gateway.
LEMMI_CONTROL_TOKEN=
# Required outer gate in live mode, separate from OIDC and scoped device tokens.
# For the deployment machine, set an independent random value (32-256 visible characters).
# Browser: HTTPS /access exchanges it for a secure HttpOnly cookie.
# Device: send X-Lemmi-Access-Key on provisioning requests and the WSS handshake.
LEMMI_ACCESS_KEY=
# Explicit fictional-only setup/profile selector. Requires PostgreSQL and the private access gate.
LEMMI_DEMO_ENROLLMENT=0
# Managed provider's RFC 7662 introspection endpoint/credentials; no sign-in UI is implemented yet.
LEMMI_AUTH_INTROSPECTION_URL=
LEMMI_AUTH_ISSUER=
LEMMI_AUTH_AUDIENCE=
# Default audience; VoidAuth non-resource tokens may use explicit client_id binding.
# In client_id mode, client_id must match this dedicated client. If aud is present,
# it must still match LEMMI_AUTH_AUDIENCE. Never infer the mode from a failed token.
LEMMI_AUTH_TOKEN_BINDING=audience
LEMMI_AUTH_CLIENT_ID=
LEMMI_AUTH_CLIENT_SECRET=
# One pre-created managed caregiver subject assigned to fictional Alex.
LEMMI_CAREGIVER_SUBJECT=
# Computer control harness only: credential returned ONCE by explicit local pairing claim.
# Never put it in browser bundles, command arguments, logs or committed files.
LEMMI_DEVICE_CREDENTIAL=
# Optional private CA bundle for a measured lab certificate setup; verification remains enabled.
LEMMI_DEVICE_CA_FILE=

# Optional text chat in the authenticated live gateway. No model requests occur without
# both key/model settings; mock mode never calls a provider. Use fictional rehearsal text.
# Copy into private .env / host configuration; never paste or commit a real API key.
OPENROUTER_API_KEY=
# Exact OpenRouter model ID chosen by Anay; no implicit model selection/fallback.
OPENROUTER_MODEL=
LEMMI_LLM_TIMEOUT_MS=20000
LEMMI_LLM_MAX_TOKENS=160
# Explicit provider-supported reasoning effort; default leaves the model's effort unchanged.
# GLM 5.3 Flash rehearsal used low + MAX_TOKENS=512; 160 can be consumed by reasoning.
LEMMI_LLM_REASONING_EFFORT=default
# Opt in to the full device speech path only after private speech configuration/health checks.
LEMMI_SPEECH_ENABLED=0
# Independent local adapters used when speech is enabled. See services/local-speech/README.md.
LEMMI_STT_BACKEND=disabled
LEMMI_TTS_BACKEND=disabled
LEMMI_STT_URL=http://127.0.0.1:8765
LEMMI_TTS_URL=http://127.0.0.1:8765
LEMMI_SPEECH_TOKEN=
LEMMI_SPEECH_TIMEOUT_MS=20000
# First test language is English. German text is supported; German speech/demo review is pending.
LEMMI_CHAT_LANGUAGE=en
# Local speech has its own private configuration/token, engine/model/device and voice settings:
# see services/local-speech/.env.example and services/local-speech/README.md.

# Optional PostgreSQL/profile/private approved-media backend. Mock mode ignores these.
# Use the host setup in db/README.md; secrets belong only in private .env/config.
LEMMI_DATABASE_URL=
LEMMI_PRIVATE_MEDIA_DIR=
# Optional db/compose.yaml host setup only:
LEMMI_POSTGRES_PASSWORD=
LEMMI_POSTGRES_PORT=5432
# Disposable integration database only; name MUST end in _test.
LEMMI_TEST_DATABASE_URL=
# Production SvelteKit adapter body ceiling; handlers apply smaller per-route limits.
BODY_SIZE_LIMIT=29M

# Local review only: use main UI components with the existing mock profile backend.
# No live microphone/session/provider services are enabled.
LEMMI_UI_PREVIEW=0

# Live caregiver exit gate: independent four-digit passcode, server-only.
# Local mock uses the fictional demo passcode 1234. This is not caregiver sign-in.
LEMMI_CAREGIVER_EXIT_PASSWORD=
