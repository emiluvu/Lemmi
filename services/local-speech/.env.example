# Example ONLY. prepare_models.py --configure creates a private .env and random token.
LEMMI_STT_BACKEND=local-http
LEMMI_TTS_BACKEND=local-http
LEMMI_STT_URL=http://127.0.0.1:8765
LEMMI_TTS_URL=http://127.0.0.1:8765
LEMMI_SPEECH_TOKEN=
LEMMI_SPEECH_PORT=8765
LEMMI_SPEECH_TIMEOUT_MS=20000
# Engine selection is independent. Each may also be 'disabled'; unsupported names fail.
LEMMI_SPEECH_STT_ENGINE=faster-whisper
LEMMI_SPEECH_TTS_ENGINE=piper
LEMMI_SPEECH_STT_MODEL_PATH=services/local-speech/.models/stt
LEMMI_SPEECH_STT_DEVICE=cpu
LEMMI_SPEECH_STT_COMPUTE=int8
LEMMI_SPEECH_THREADS=4
LEMMI_SPEECH_VOICE_EN=services/local-speech/.models/tts/en_US-hfc_female-medium.onnx
# German voice selection/quality checks are a later demo task. No English substitution.
LEMMI_SPEECH_VOICE_DE=
