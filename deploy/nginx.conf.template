events {}
http {
server {
    listen 127.0.0.1:8080 default_server;
    server_name _;
    access_log off;
    return 404;
}

server {
    listen 127.0.0.1:8080;
    server_name YOUR_DOMAIN;
    access_log off;
    client_max_body_size 4k;
    client_body_timeout 5s;

    # Trust only the same-host tunnel, and reject public plaintext requests.
    if ($http_x_forwarded_proto != "https") { return 403; }

    location = /v1/device-stream {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host YOUR_DOMAIN;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 30s;
        proxy_buffering off;
    }

    location ~ ^/(access(/logout)?|v1/(devices/[^/]+/(pairings|revoke)|device-pairings/claim))$ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host YOUR_DOMAIN;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
    }

    # Explicit fictional demo/browser routes, independently authorized by the app.
    location ~ ^/(participant|_app/.*|v1/demo/(profiles|enroll|current|release))$ {
        client_max_body_size 4k;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host YOUR_DOMAIN;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
    }

    # Reviewed generic UI artwork/fonts only, never participant/private media.
    # Static resources contain no credentials or profile data; no broad /images alias.
    location ~ ^/(fonts/nunito-latin-variable\.ttf|images/(avatars/(dog|cat|bunny|bird|lemming)\.png|surfaces/(cream-paper-v1|conversation-meadow-v1)\.png))$ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host YOUR_DOMAIN;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
    }

    # Optional database-backed profile and media resources.
    location ~ ^/v1/profiles/[^/]+/(photos|assets)$ {
        client_max_body_size 29m;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host YOUR_DOMAIN;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
    }
    location ~ ^/v1/profiles/[^/]+/communication-support(/apply)?$ {
        client_max_body_size 4k;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host YOUR_DOMAIN;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
    }
    location ~ ^/v1/(profiles/[^/]+(/assets/[^/]+)?|participant/profiles/[^/]+|assets/[^/]+(/metadata)?)$ {
        client_max_body_size 32k;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host YOUR_DOMAIN;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
    }
    location / { return 404; }
}
}
